# Copy this template to config/.env on the deployment host.
# Never commit the real config/.env file or place credentials in source control.

POP_AUDIT_HOST_PORT=18000

ZABBIX_URL=https://zabbix.example.invalid
ZABBIX_USER=CHANGE_ME
ZABBIX_PASSWORD=CHANGE_ME
ZABBIX_GROUP_ENODEB=LTE-Backhaul-eNodeB
ZABBIX_GROUP_SWITCH=LTE-Backhaul-Switch
ZABBIX_GROUP_SWITCH_AGGREGATION=LTE-Backhaul-Switch-Aggregation
ZABBIX_GROUP_RADIO=LTE-Backhaul-Radio
ZABBIX_GROUP_RADIO_HUAWEI=LTE-Backhaul-Radio-Huawei

SSH_USERNAME=CHANGE_ME
SSH_PASSWORD=CHANGE_ME
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30

MOSHELL_HOST=CHANGE_ME
MOSHELL_USER=CHANGE_ME
MOSHELL_PASSWORD=CHANGE_ME
MOSHELL_PATH=/opt/moshell/moshell

RADIO_MODULATION_HISTORY_HOURS=12
