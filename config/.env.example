# Copy this file to config/.env on the deployment host and set real values there.
# Never commit config/.env or put production credentials in this template.

APP_ENV=development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pop_audit
DATABASE_USER=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME

ZABBIX_URL=https://zabbix.example.invalid
ZABBIX_USER=CHANGE_ME
ZABBIX_PASSWORD=CHANGE_ME

SSH_USERNAME=CHANGE_ME
SSH_PASSWORD=CHANGE_ME
MOSHELL_HOST=CHANGE_ME
MOSHELL_USER=CHANGE_ME
MOSHELL_PASSWORD=CHANGE_ME

ZABBIX_GROUP_ENODEB=CHANGE_ME
ZABBIX_GROUP_SWITCH=CHANGE_ME
ZABBIX_GROUP_RADIO=CHANGE_ME

GATEWAY_URL=http://gateway:8000
ORCHESTRATOR_URL=http://orchestrator:8001
ZABBIX_SERVICE_URL=http://zabbix-service:8002
CISCO_SERVICE_URL=http://cisco-service:8003
ERICSSON_SERVICE_URL=http://ericsson-service:8004
RADIO_SERVICE_URL=http://radio-service:8005
REPORT_SERVICE_URL=http://report-service:8006

DIFFERENCE_THRESHOLD=7
MODULATION_EXPECTED=13
RADIO_ANALYSIS_HOURS=6
RADIO_HISTORY_DAYS=7
MAX_CONCURRENT_DEVICES=4
MAX_CONCURRENT_BASEBANDS=4
MAX_CONCURRENT_RADIO_LINKS=4
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30
