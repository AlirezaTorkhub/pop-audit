# Copy to config/.env on the deployment host and fill in private values.
# Never commit config/.env or any credential.

APP_ENV=production

# Zabbix API
ZABBIX_URL=http://YOUR_ZABBIX_SERVER
ZABBIX_USER=YOUR_ZABBIX_API_USER
ZABBIX_PASSWORD=REPLACE_ME

# Zabbix host groups
ZABBIX_GROUP_ENODEB=LTE-Backhaul-eNodeB
ZABBIX_GROUP_SWITCH=LTE-Backhaul-Switch
ZABBIX_GROUP_SWITCH_AGGREGATION=LTE-Backhaul-Switch-Aggregation
ZABBIX_GROUP_RADIO=LTE-Backhaul-Radio
ZABBIX_GROUP_RADIO_HUAWEI=LTE-Backhaul-Radio-Huawei

# SSH access for Cisco and NCS
SSH_USERNAME=YOUR_SSH_USER
SSH_PASSWORD=REPLACE_ME
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30

# Ericsson Moshell jump host
MOSHELL_HOST=YOUR_MOSHELL_SERVER
MOSHELL_USER=YOUR_MOSHELL_USER
MOSHELL_PASSWORD=REPLACE_ME
MOSHELL_PATH=/path/to/moshell

# Radio rules / history
DIFFERENCE_THRESHOLD=7
MODULATION_EXPECTED=13
RADIO_ANALYSIS_HOURS=6
RADIO_HISTORY_DAYS=7
RADIO_MODULATION_HISTORY_HOURS=12

# Compose
POP_AUDIT_HOST_PORT=18000
MAX_CONCURRENT_DEVICES=4
MAX_CONCURRENT_BASEBANDS=2
MAX_CONCURRENT_RADIO_LINKS=4
