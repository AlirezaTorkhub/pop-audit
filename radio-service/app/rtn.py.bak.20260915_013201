from __future__ import annotations

import re
from typing import Any


DESTINATIONS = {
    "BOLVARSHAHRZAD",
    "BORJMINA",
    "GHOBA",
    "HOSEINIEHERSHAD",
    "MAHABGHODS",
    "SHAMS",
    "ZOMOROD",
}


def to_float(value: Any):
    if value is None:
        return None

    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def aggregate_status(statuses: list[str]) -> str:
    order = {
        "CRITICAL": 5,
        "WARNING": 4,
        "UNKNOWN": 3,
        "NOT_AVAILABLE": 2,
        "PASS": 1,
    }

    if not statuses:
        return "UNKNOWN"

    return max(
        statuses,
        key=lambda x: order.get(x, 3),
    )


def decode_zabbix_encoded(text: str) -> str:
    """
    Decode Huawei/Zabbix encoded identifiers.

    Example:
        26.26.98.111.97.114.100.61.49...

    becomes:
        board=1,...

    The two leading 26 bytes are control characters and
    are intentionally ignored.
    """

    if not text:
        return text

    parts = text.split(".")

    values = []

    for part in parts:
        try:
            value = int(part)
        except (TypeError, ValueError):
            return text

        if not 0 <= value <= 255:
            return text

        values.append(value)

    # Huawei encoded traffic strings in this host
    # start with two ASCII control characters (26, 26).
    while values and values[0] == 26:
        values.pop(0)

    if not values:
        return ""

    try:
        decoded = "".join(
            chr(value)
            for value in values
        )
    except ValueError:
        return text

    printable = sum(
        1
        for character in decoded
        if character.isprintable()
        or character in "\r\n\t"
    )

    if not decoded:
        return text

    if printable / len(decoded) >= 0.85:
        return decoded

    return text


def evaluate_modulation(value: Any) -> dict:
    value = to_float(value)

    if value is None:
        return {
            "status": "NOT_AVAILABLE",
            "value": None,
            "threshold": 13,
            "description": "Modulation value unavailable",
        }

    if value < 13:
        return {
            "status": "WARNING",
            "value": value,
            "threshold": 13,
            "description": "Modulation below 13",
        }

    return {
        "status": "PASS",
        "value": value,
        "threshold": 13,
        "description": "Modulation is normal",
    }


def evaluate_difference(value: Any) -> dict:
    value = to_float(value)

    if value is None:
        return {
            "status": "NOT_AVAILABLE",
            "value": None,
            "threshold": 7,
            "description": "Difference unavailable",
        }

    if value > 7:
        return {
            "status": "WARNING",
            "value": value,
            "threshold": 7,
            "description": "Difference above 7",
        }

    return {
        "status": "PASS",
        "value": value,
        "threshold": 7,
        "description": "Difference is normal",
    }


def evaluate_traffic(value: Any) -> dict:
    value = to_float(value)

    if value is None:
        return {
            "status": "NOT_AVAILABLE",
            "value": None,
            "warning_threshold": 350_000_000,
            "high_threshold": 410_000_000,
            "description": "Traffic unavailable",
        }

    if value > 410_000_000:
        return {
            "status": "WARNING",
            "value": value,
            "warning_threshold": 350_000_000,
            "high_threshold": 410_000_000,
            "description": "Traffic above 410 Mbps",
        }

    if value > 350_000_000:
        return {
            "status": "WARNING",
            "value": value,
            "warning_threshold": 350_000_000,
            "high_threshold": 410_000_000,
            "description": "Traffic above 350 Mbps",
        }

    return {
        "status": "PASS",
        "value": value,
        "warning_threshold": 350_000_000,
        "high_threshold": 410_000_000,
        "description": "Traffic is normal",
    }


def evaluate_packet_loss(value: Any) -> dict:
    value = to_float(value)

    if value is None:
        return {
            "status": "NOT_AVAILABLE",
            "value": None,
            "warning_threshold": 5,
            "critical_threshold": 80,
            "description": "Packet loss unavailable",
        }

    if value > 80:
        return {
            "status": "CRITICAL",
            "value": value,
            "warning_threshold": 5,
            "critical_threshold": 80,
            "description": "Packet loss above 80%",
        }

    if value > 20:
        return {
            "status": "WARNING",
            "value": value,
            "warning_threshold": 5,
            "critical_threshold": 80,
            "description": "Packet loss above 20%",
        }

    if value >= 5:
        return {
            "status": "WARNING",
            "value": value,
            "warning_threshold": 5,
            "critical_threshold": 80,
            "description": "Packet loss at/above 5%",
        }

    return {
        "status": "PASS",
        "value": value,
        "warning_threshold": 5,
        "critical_threshold": 80,
        "description": "Packet loss is normal",
    }


def extract_item_ids(expression: str) -> list[str]:
    return re.findall(
        r"\{(\d+)\}",
        expression or "",
    )


def extract_destination(
    description: str,
) -> str | None:

    upper = (
        description or ""
    ).upper()

    for destination in DESTINATIONS:
        if destination in upper:
            return destination

    return None


def build_trigger_index(
    triggers: list[dict],
) -> dict[str, list[dict]]:
    """
    Build:

        itemid -> [trigger, trigger, ...]

    Prefer trigger["items"] from Zabbix selectItems.
    Fall back to item IDs inside the expression.
    """

    result: dict[str, list[dict]] = {}

    for trigger in triggers:

        trigger_items = (
            trigger.get("items")
            or []
        )

        for item in trigger_items:

            itemid = str(
                item.get("itemid", "")
            ).strip()

            if not itemid:
                continue

            result.setdefault(
                itemid,
                [],
            ).append(trigger)

        if not trigger_items:

            expression = trigger.get(
                "expression",
                "",
            )

            for itemid in extract_item_ids(
                expression
            ):

                result.setdefault(
                    itemid,
                    [],
                ).append(trigger)

    return result


def modulation_links(
    items: list[dict],
    triggers: list[dict],
) -> list[dict]:

    trigger_index = build_trigger_index(
        triggers
    )

    result = []

    for item in items:

        key = str(
            item.get("key_", "")
        )

        if not key.lower().startswith(
            "modulation_huawei["
        ):
            continue

        itemid = str(
            item.get("itemid", "")
        )

        related = trigger_index.get(
            itemid,
            [],
        )

        destinations = []

        for trigger in related:

            destination = extract_destination(
                trigger.get(
                    "description",
                    "",
                )
            )

            if (
                destination
                and destination not in destinations
            ):
                destinations.append(
                    destination
                )

        if not destinations:
            destinations = [None]

        link_name = key

        prefix = "Modulation_huawei["

        if (
            key.startswith(prefix)
            and key.endswith("]")
        ):
            link_name = key[
                len(prefix):-1
            ]

        for destination in destinations:

            result.append({
                "itemid": itemid,
                "key": key,
                "link": link_name,
                "destination": destination,
                "value": to_float(
                    item.get("lastvalue")
                ),
                "clock": item.get(
                    "lastclock"
                ),
            })

    return result


def traffic_items(
    items: list[dict],
) -> list[dict]:

    result = []

    for item in items:

        key = str(
            item.get("key_", "")
        )

        lower_key = key.lower()

        if not (
            lower_key.startswith(
                "rx_traffic["
            )
            or lower_key.startswith(
                "tx_traffic["
            )
        ):
            continue

        direction = (
            "RX"
            if lower_key.startswith(
                "rx_traffic["
            )
            else "TX"
        )

        encoded = ""

        if "[" in key:
            encoded = key.split(
                "[",
                1,
            )[1].rstrip("]")

        result.append({
            "itemid": str(
                item.get("itemid")
            ),
            "key": key,
            "direction": direction,
            "source": encoded,
            "decoded_source": decode_zabbix_encoded(
                encoded
            ),
            "value": to_float(
                item.get("lastvalue")
            ),
            "clock": item.get(
                "lastclock"
            ),
        })

    return result


def difference_items(
    items: list[dict],
) -> list[dict]:

    result = []

    for item in items:

        key = str(
            item.get("key_", "")
        )

        lower_key = key.lower()

        if not lower_key.startswith(
            "rx_tx_diff_"
        ):
            continue

        destination = key[
            len("rx_tx_diff_"):
        ]

        if destination.endswith("_1"):
            destination = destination[:-2]

        result.append({
            "itemid": str(
                item.get("itemid")
            ),
            "key": key,
            "destination": destination.upper(),
            "value": to_float(
                item.get("lastvalue")
            ),
            "clock": item.get(
                "lastclock"
            ),
        })

    return result


def packet_loss_item(
    items: list[dict],
) -> dict | None:

    for item in items:

        key = str(
            item.get("key_", "")
        ).lower()

        if key != "packetloss":
            continue

        value = to_float(
            item.get("lastvalue")
        )

        check = evaluate_packet_loss(
            value
        )

        return {
            "itemid": str(
                item.get("itemid")
            ),
            "key": item.get("key_"),
            "value": value,
            "clock": item.get(
                "lastclock"
            ),
            **check,
        }

    return None


def analyze_rtn(
    items: list[dict],
    triggers: list[dict],
) -> dict:

    modulation = modulation_links(
        items,
        triggers,
    )

    differences = difference_items(
        items
    )

    traffic = traffic_items(
        items
    )

    packet_loss = packet_loss_item(
        items
    )

    link_results: dict[
        str,
        dict,
    ] = {}

    # ---------------------------------------------------------
    # Difference
    # ---------------------------------------------------------

    for entry in differences:

        destination = entry[
            "destination"
        ]

        if destination not in DESTINATIONS:
            continue

        link_results.setdefault(
            destination,
            {
                "destination": destination,
                "modulation": [],
                "difference": None,
                "traffic": [],
                "statuses": [],
            },
        )

        check = evaluate_difference(
            entry["value"]
        )

        link_results[
            destination
        ]["difference"] = {
            "itemid": entry["itemid"],
            "value": entry["value"],
            **check,
        }

        link_results[
            destination
        ]["statuses"].append(
            check["status"]
        )

    # ---------------------------------------------------------
    # Modulation
    # ---------------------------------------------------------

    for entry in modulation:

        destination = entry[
            "destination"
        ]

        if not destination:
            continue

        link_results.setdefault(
            destination,
            {
                "destination": destination,
                "modulation": [],
                "difference": None,
                "traffic": [],
                "statuses": [],
            },
        )

        check = evaluate_modulation(
            entry["value"]
        )

        link_results[
            destination
        ]["modulation"].append({
            "itemid": entry["itemid"],
            "link": entry["link"],
            "value": entry["value"],
            **check,
        })

        link_results[
            destination
        ]["statuses"].append(
            check["status"]
        )

    # ---------------------------------------------------------
    # Traffic
    #
    # Traffic remains host-level until we have a verified
    # production mapping from encoded board/subcard/port
    # identifiers to RTN destinations.
    # ---------------------------------------------------------

    traffic_results = []

    for entry in traffic:

        check = evaluate_traffic(
            entry["value"]
        )

        traffic_results.append({
            "itemid": entry["itemid"],
            "direction": entry["direction"],
            "source": entry["source"],
            "decoded_source": entry[
                "decoded_source"
            ],
            "value": entry["value"],
            **check,
        })

    # ---------------------------------------------------------
    # Per-destination status
    # ---------------------------------------------------------

    for link in link_results.values():

        link["status"] = aggregate_status(
            link["statuses"]
        )

        link.pop(
            "statuses",
            None,
        )

    # ---------------------------------------------------------
    # Overall status
    # ---------------------------------------------------------

    status_inputs = [
        link["status"]
        for link in link_results.values()
    ]

    status_inputs.extend(
        item["status"]
        for item in traffic_results
        if item["status"]
        != "NOT_AVAILABLE"
    )

    if packet_loss is not None:
        status_inputs.append(
            packet_loss["status"]
        )

    overall_status = aggregate_status(
        status_inputs
    )

    # ---------------------------------------------------------
    # Final result
    # ---------------------------------------------------------

    return {
        "type": "RTN",
        "status": overall_status,
        "summary": {
            "link_count": len(
                link_results
            ),
            "modulation_count": len(
                modulation
            ),
            "difference_count": len(
                differences
            ),
            "traffic_count": len(
                traffic_results
            ),
        },
        "links": list(
            link_results.values()
        ),
        "packet_loss": packet_loss,
        "traffic": traffic_results,
    }
